node_modules
dist
data/**/*.csv
!data/projections-*.csv
!data/boberto-*.csv
!data/auction/sleeper-board-*.csv
data/**/*.json
# Local HTML previews (blended-price, draft-demo, live-rank, queue-builder,
# vorp-snake) -- regenerated by their script, nothing reads a committed copy.
data/**/*.html
# The queue builder's page data. Committed because the Railway server has to
# serve it and cannot rebuild it: the board it derives from (data/vorp-snake-*.csv,
# data/adp-*.csv) is ignored above. Answers -- queue-prefs-*.json -- stay out.
!data/snake/queue-payload-*.json
# The board server's disk-persisted scrub frames -- see
# docs/spec/board/04-time-travel-scrubber.md. One dir per draft id/picks-file
# stem, deep enough that data/**/*.json above doesn't already cover it.
data/auction/frames-*/
.env
.env.local
.DS_Store

# Playwright MCP's own scratch output -- console logs and page snapshots
# from browser sessions, not source.
.playwright-mcp/

# Built Artifact pages -- regenerate with python/artifact/build_*.py.
# Derived from data/*.json, which is itself ignored above; the draft-demo
# build alone is 8MB of near-duplicate HTML (fragment + local skeleton).
artifacts/
